<?xml version="1.0" encoding="utf-8"?>
<!--
  L'application fonctionne à 100 % hors ligne : tout le contenu est embarqué dans l'APK (dossier assets/).
  Internet ne sert qu'à télécharger des cartes, à la demande de l'utilisateur.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Matériel optionnel : sans flash ni boussole, l'application se replie sur l'écran ou un message. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Internet : uniquement pour parcourir le catalogue et télécharger des cartes hors ligne.
         Tout le reste de l'application (fiches, outils, cartes déjà téléchargées) fonctionne sans réseau. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Position GPS sur les cartes hors ligne (le GPS fonctionne sans réseau). Facultatif. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Micro : uniquement pour décoder le Morse à l'oreille, analysé en direct sur le téléphone, rien n'est enregistré. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".SurviveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Survive">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
